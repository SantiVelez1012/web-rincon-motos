---
interface Step {
	number: string;
	label: string;
}

interface Props {
	eyebrow: string;
	title: string;
	description: string;
	steps: Step[];
}

const { eyebrow, title, description, steps } = Astro.props;
---

<aside class="relative overflow-hidden border-l-4 border-agencia-acento bg-agencia-tarjeta p-7 text-agencia-texto md:p-9" aria-labelledby="illustrative-panel-title">
	<div class="absolute -right-8 -top-8 h-28 w-28 rounded-full border border-agencia-acento/30" aria-hidden="true"></div>
	<div class="absolute right-7 top-7 flex gap-1" aria-hidden="true">
		<span class="h-2 w-2 rounded-full bg-agencia-acento"></span>
		<span class="h-2 w-2 rounded-full bg-agencia-acento/50"></span>
		<span class="h-2 w-2 rounded-full bg-agencia-acento/20"></span>
	</div>

	<p class="relative font-agencia-titulo text-xs font-bold uppercase tracking-tight text-agencia-acento">{eyebrow}</p>
	<h2 id="illustrative-panel-title" class="relative mt-4 max-w-sm font-agencia-titulo text-2xl font-extrabold tracking-tight text-agencia-texto">{title}</h2>
	<p class="relative mt-4 leading-relaxed text-agencia-texto-mutado">{description}</p>

	<ol class="relative mt-8 grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
		{steps.map((step) => (
			<li class="flex items-center gap-4 border-t border-agencia-acento/30 pt-4">
				<span class="font-agencia-titulo text-2xl font-extrabold text-agencia-acento" aria-hidden="true">{step.number}</span>
				<span class="font-medium text-agencia-texto">{step.label}</span>
			</li>
		))}
	</ol>
</aside>
