---
interface Props {
	number: string;
	title: string;
	pain: string;
	description: string;
	benefits: string[];
	ctaHref: string;
}

const { number, title, pain, description, benefits, ctaHref } = Astro.props;
---

<article class="group flex h-full flex-col overflow-hidden rounded-3xl border border-agencia-acento/30 bg-agencia-tarjeta p-6 transition-transform hover:-translate-y-1 md:p-8">
	<div class="flex items-start justify-between gap-4 border-b border-agencia-acento/30 pb-6">
		<div>
			<p class="font-agencia-titulo text-xs font-bold uppercase tracking-tight text-agencia-acento">Trámite 0{number}</p>
			<div class="mt-3 h-1 w-12 bg-agencia-acento transition-all group-hover:w-20"></div>
		</div>
		<span class="font-agencia-titulo text-5xl font-extrabold leading-none text-agencia-acento/20" aria-hidden="true">{number}</span>
	</div>

	<h3 class="mt-7 font-agencia-titulo text-2xl font-extrabold leading-tight tracking-tight text-agencia-acento">{title}</h3>
	<p class="mt-4 border-l-2 border-agencia-acento/50 pl-4 text-sm italic leading-relaxed text-agencia-texto-mutado">{pain}</p>
	<p class="mt-5 leading-relaxed text-agencia-texto">{description}</p>

	<ul class="mt-7 space-y-3 leading-relaxed text-agencia-texto-mutado">
		{benefits.map((benefit) => (
			<li class="flex gap-3">
				<span class="font-bold text-agencia-acento" aria-hidden="true">✓</span>
				<span>{benefit}</span>
			</li>
		))}
	</ul>

	<div class="mt-auto pt-8">
		<a href={ctaHref} target="_blank" rel="noreferrer" class="flex h-14 w-full items-center justify-center rounded-lg bg-agencia-whatsapp px-5 text-center font-agencia-titulo text-sm font-bold uppercase text-agencia-fondo shadow-md transition-transform hover:scale-105 active:scale-95">
			Consultar este trámite
		</a>
		<p class="mt-3 min-h-8 text-xs leading-relaxed text-agencia-texto-mutado">Te explicamos requisitos, tiempos y próximos pasos.</p>
	</div>
</article>
