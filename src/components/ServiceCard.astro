---
interface Props {
	number: string;
	title: string;
	description: string;
	benefits: string[];
	ctaHref: string;
	ctaLabel: string;
	note: string;
}

const { number, title, description, benefits, ctaHref, ctaLabel, note } = Astro.props;
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-agencia-acento/30 bg-agencia-tarjeta p-6 transition-transform hover:-translate-y-1 md:p-8">
	<div class="absolute right-6 top-1 font-agencia-titulo text-7xl font-extrabold leading-none text-agencia-acento/15 md:right-8" aria-hidden="true">{number}</div>
	<div class="relative flex items-start justify-between gap-4 border-b border-agencia-acento/30 pb-6">
		<div>
			<div class="mt-3 h-1 w-12 bg-agencia-acento transition-all group-hover:w-20"></div>
		</div>
		<span class="flex h-10 w-10 items-center justify-center rounded-full border border-agencia-acento/50 font-agencia-titulo text-sm font-bold text-agencia-acento" aria-hidden="true">↗</span>
	</div>

	<h3 class="relative mt-7 font-agencia-titulo text-2xl font-extrabold tracking-tight text-agencia-acento">{title}</h3>
	<p class="mt-3 leading-relaxed text-agencia-texto">{description}</p>

	<ul class="mt-7 space-y-3 leading-relaxed text-agencia-texto-mutado">
		{benefits.map((benefit) => (
			<li class="flex gap-3">
				<span class="mt-1 font-bold text-agencia-acento" aria-hidden="true">+</span>
				<span>{benefit}</span>
			</li>
		))}
	</ul>

	<div class="mt-auto pt-8">
		<p class="mb-3 min-h-8 text-xs leading-relaxed text-agencia-texto-mutado">{note}</p>
		<a href={ctaHref} target="_blank" rel="noreferrer" class="flex h-14 w-full shrink-0 items-center justify-center rounded-lg bg-agencia-whatsapp px-5 text-center font-agencia-titulo font-bold uppercase text-agencia-fondo shadow-md transition-transform hover:scale-105 active:scale-95">
			{ctaLabel}
		</a>
	</div>
</article>
